.env
config/pragma.yaml

# Playwright storage-state files contain real session cookies/localStorage -
# never commit these, wherever the user chose to save them.
storage_state*.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store

# Neo4j backups (scripts/neo4j_backup.sh) - binary dumps of a full crawled
# graph, potentially large, never worth version-controlling.
backups/

# All generated run output - PRD/tree/catalog/etc. documents, the run index
# and manifest (PragmaConfig.out_dir, default data/output), and per-run debug
# artifacts (PragmaConfig.debug_logs_dir, default data/debug_logs). Ignoring
# the whole directory rather than listing individual filename patterns is
# deliberate: docs/www.empanad.app__*.md once slipped into git because the
# old pattern list only covered prd/tree/graph output, not every document
# type the pipeline can produce.
data/

# The same generated-run-output problem, but for --out docs (an older
# default out_dir, before it moved to data/output) - docs/adr/, docs/agents/,
# docs/dev/, docs/index.md and docs/runs.json are real tracked content, so
# docs/ itself can't be ignored wholesale the way data/ is. The site-prefixed
# "__" in every generated filename (docs/<site>__<document>_<timestamp>.ext)
# is what neither of those real entries ever contains - caught after a real
# crawl run against --out docs slipped its output into a commit unrelated to
# it, the same class of incident the data/ comment above already describes.
docs/*__*
docs/dashboard/
