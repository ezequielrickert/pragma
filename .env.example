URL=https://example.com
AGENT_PROVIDER=local

# Model name and endpoint can also be set in config/pragma.yaml under `agents:`
# (see config/pragma.example.yaml) if you'd rather not grow this file further -
# but keep API keys and credential paths here, not in a committed YAML file.

# --- local (LM Studio / any OpenAI-compatible server) ---
LOCAL_API_URL=http://localhost:1234/v1/chat/completions
LOCAL_MODEL=google/gemma-4-e2b
# Optional: only needed if the endpoint above requires bearer-token auth, e.g.
# an LM Studio instance exposed through a tunnel (Tailscale Funnel/Serve, ngrok,
# etc.) rather than reached directly on localhost/LAN.
LOCAL_API_KEY=
# Optional: per-request HTTP timeout in seconds. Default 300s; a larger local
# model (especially a reasoning model like DeepSeek-R1) can easily need more,
# particularly over a tunnel - raise this rather than treating a slow-but-
# real response as a failure. Same setting as agents.local.timeout in
# config/pragma.yaml (that value wins if both are set).
LOCAL_TIMEOUT=300
# Optional: caps each response's generated tokens. Unset by default - a
# reasoning model needs room for its chain-of-thought before its actual
# answer/tool call, and guessing a "safe" cap risks silently truncating that
# mid-thought (which then fails to parse as a valid action - worse than just
# being slow). Only set this once you know your model's real budget. Same
# setting as agents.local.max_tokens in config/pragma.yaml (that value wins if
# both are set).
LOCAL_MAX_TOKENS=
