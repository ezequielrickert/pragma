URL=https://example.com
AGENT_PROVIDER=gemini

# You only need to fill in the section below matching AGENT_PROVIDER (or --agent).
# Model names and endpoints can also be set per-provider in pragma.yaml under
# `agents:` (see pragma.example.yaml) if you'd rather not grow this file further -
# but keep API keys and credential paths here, not in a committed YAML file.

# --- gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-1.5-flash
# Optional: use a service account instead of GEMINI_API_KEY
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# --- local (LM Studio / any OpenAI-compatible server) ---
LOCAL_API_URL=http://localhost:1234/v1/chat/completions
LOCAL_MODEL=google/gemma-4-e2b
# Optional: only needed if the endpoint above requires bearer-token auth, e.g.
# an LM Studio instance exposed through a tunnel (Tailscale Funnel/Serve, ngrok,
# etc.) rather than reached directly on localhost/LAN.
LOCAL_API_KEY=

# --- Module 3: unified REST API (execution + curated docs), scraper: rest ---
# Only needed if `python -m src.api_server` is running somewhere other than the
# default localhost:8765 - see ARCHITECTURE.md's "Module 3: Unified REST API".
# PRAGMA_API_URL=http://127.0.0.1:8765
