URL=https://example.com
AGENT_PROVIDER=gemini
# Preferred: Gemini API key for Google Generative Language API
GEMINI_API_KEY=
# Optional: which Gemini/Vertex model to use (e.g., models/gemini-1.5-flash)
GEMINI_MODEL=models/gemini-1.5-flash
# Legacy: OpenAI API key (used only if AGENT_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
