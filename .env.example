URL=https://example.com
AGENT_PROVIDER=gemini

# You only need to fill in the section below matching AGENT_PROVIDER (or --agent).
# Model names and endpoints can also be set per-provider in pragma.yaml under
# `agents:` (see pragma.example.yaml) if you'd rather not grow this file further -
# but keep API keys and credential paths here, not in a committed YAML file.

# --- gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-1.5-flash
# Optional: use a service account instead of GEMINI_API_KEY
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# --- local (LM Studio / any OpenAI-compatible server) ---
LOCAL_API_URL=http://localhost:1234/v1/chat/completions
LOCAL_MODEL=google/gemma-4-e2b
