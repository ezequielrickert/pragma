{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragma.local/schemas/confidence-summary.schema.json",
  "title": "Confidence summary",
  "description": "docs/adr/0029: derived confidence rollups over requirements.json, data-model.json, usability.earl.jsonld, and accessibility.earl.jsonld - each entry cites its source document by reference (DocumentOutput.filename), never restating an individual entity's own confidence value. Per-run snapshot only; cross-run trends are change-log.json's job (ADR-0019).",
  "type": "object",
  "required": ["run_id", "sources"],
  "$defs": {
    "confidence_category_rollup": {
      "type": "object",
      "required": ["source_document", "by_confidence", "total"],
      "properties": {
        "source_document": { "type": "string" },
        "by_confidence": {
          "type": "object",
          "required": ["observed", "inferred", "assumed"],
          "properties": {
            "observed": { "type": "integer", "minimum": 0 },
            "inferred": { "type": "integer", "minimum": 0 },
            "assumed": { "type": "integer", "minimum": 0 }
          }
        },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "confidence_score_rollup": {
      "type": "object",
      "required": ["source_document", "count", "mean_confidence", "min_confidence", "max_confidence"],
      "properties": {
        "source_document": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "mean_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "min_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "max_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "earl_level_rollup": {
      "type": "object",
      "required": ["source_document", "by_level", "total"],
      "properties": {
        "source_document": { "type": "string" },
        "by_level": {
          "type": "object",
          "required": ["error", "warning", "note", "none"],
          "properties": {
            "error": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "note": { "type": "integer", "minimum": 0 },
            "none": { "type": "integer", "minimum": 0 }
          }
        },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "run_id": { "type": "string" },
    "sources": {
      "type": "object",
      "required": ["prd", "data-model", "usability", "accessibility"],
      "properties": {
        "prd": { "$ref": "#/$defs/confidence_category_rollup" },
        "data-model": { "$ref": "#/$defs/confidence_score_rollup" },
        "usability": { "$ref": "#/$defs/earl_level_rollup" },
        "accessibility": { "$ref": "#/$defs/earl_level_rollup" }
      }
    }
  }
}
